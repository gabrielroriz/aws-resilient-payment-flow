{
  "name": "aws-resilient-payment-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && tsc -p build && node build/index.mts",
    "dev": "bash scripts/dev/index.sh",
    "dev:debug": "DEV_DEBUG=1 bash scripts/dev/index.sh",
    "dev:reset-db": "bash scripts/dev/reset-db.sh",
    "dev:workflows": "bash scripts/dev/watch-workflows.sh",
    "deploy": "bash scripts/deploy/index.sh",
    "format": "prettier --write \"**/*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs}\"",
    "simulate": "node scripts/simulator/simulate.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p build && tsc -p scripts/dev && tsc -p scripts/simulator && tsc -p scripts/lint"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@aws/durable-execution-sdk-js-testing": "^1.3.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@aws/durable-execution-sdk-js": "^2.7.1",
    "dynamodb-toolbox": "^2.11.0",
    "zod": "^4.6.5"
  }
}
