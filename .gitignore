# Downloaded providers and modules.
**/.terraform/*

# State files can contain secrets.
*.tfstate
*.tfstate.*

# Local variable values can contain secrets.
*.tfvars
*.tfvars.json
# Local-only secrets npm run dev uses, safe to share.
!terraform/secrets.local.tfvars

# Saved plans (use these extensions when saving plans).
*.tfplan
*.tfplan.*

# Crash logs.
crash.log
crash.*.log

# Local CLI configuration.
.terraformrc
terraform.rc

# Node.js dependencies and Lambda build output.
node_modules/
/dist/

# Local Lambda invocation output.
/response.json

# SAM's generated Terraform metadata and extracted local artifacts.
**/.aws-sam/
**/.aws-sam-iacs/

# State of the durable execution emulator SAM runs for local durable functions.
/.durable-executions-local/
