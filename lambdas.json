{
  "health": {
    "entry": "src/main/functions/health.ts",
    "http_method": "GET",
    "path": "/health"
  },
  "webhook_entry_point": {
    "entry": "src/main/functions/webhooks/webhookEntryPoint.ts",
    "role": "webhook_entry_point",
    "memory_size": 512,
    "timeout": 30,
    "http_method": "POST",
    "path": "/webhooks/{provider}"
  },
  "webhook_worker": {
    "entry": "src/main/functions/webhooks/webhookWorker.ts",
    "trigger": "sqs",
    "role": "webhook_worker",
    "memory_size": 512,
    "timeout": 30
  },
  "wf_subscription_grant_access": {
    "entry": "src/main/functions/subscriptions/subscriptionGrantAccess.ts",
    "trigger": "durable",
    "execution_timeout": 86400,
    "role": "subscription_grant_access",
    "memory_size": 512,
    "timeout": 30
  }
}
