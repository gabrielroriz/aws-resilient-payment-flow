{
  // The README shows the architecture diagram in dark mode, so saved Excalidraw images must keep it.
  "excalidraw.image": {
    "exportScale": 1,
    "exportWithBackground": true,
    "exportWithDarkMode": true
  },
  // Format code with the project's Prettier on every save, matching the check CI runs. Other file
  // types, such as Markdown, keep their own formatting.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  }
}
